# Nelva BE config
PORT=8090

# CORS: lock to the FE origin(s) in production (comma-separated). Unset = allow-all (local dev).
# e.g. FE_ORIGIN=https://nelva.vercel.app
# FE_ORIGIN=

# Ledger mode: "mock" (in-memory, no Canton) or "canton" (real JSON Ledger API).
LEDGER_MODE=mock

# Used only when LEDGER_MODE=canton (dpm sandbox on 7575):
JSON_LEDGER_API=http://localhost:7575
LEDGER_USER_ID=nelva-be
# Package id of the deployed DAR — get with: dpm damlc inspect-dar --json <dar>
# UPDATE this whenever the SC (DAR) is rebuilt.
NELVA_PACKAGE_ID=e60f573a2bb609093d80bf0d655bcc3359b19e08857766b4a9c68a3396bae284

# JWT auth (DevNet / LocalNet / NaaS). Leave AUTH_TOKEN_URL UNSET for dpm sandbox (no auth).
# OAuth2 client_credentials → Bearer on every Ledger API call.
# AUTH_TOKEN_URL=https://<oidc-issuer>/realms/<realm>/protocol/openid-connect/token
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_SCOPE=daml_ledger_api
# AUTH_AUDIENCE=
