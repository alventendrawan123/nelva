# Nelva BE config
PORT=8090

# CORS: lock to the FE origin(s) in production (comma-separated). Unset = allow-all (local dev).
# e.g. FE_ORIGIN=https://nelva.vercel.app
# FE_ORIGIN=

# Ledger mode: "mock" (in-memory, no Canton) or "canton" (real JSON Ledger API).
LEDGER_MODE=mock

# Used only when LEDGER_MODE=canton (dpm sandbox on 7575):
JSON_LEDGER_API=http://localhost:7575
LEDGER_USER_ID=nelva-be
# Package id of the deployed DAR — get with: dpm damlc inspect-dar --json <dar>
# UPDATE this whenever the SC (DAR) is rebuilt. Must be EXACTLY 64 hex chars.
NELVA_PACKAGE_ID=198e9be837647ec88bec2e2b7d636977bb2ed1e4e0b7e51d481073d626e98585

# Party name prefix. On a SHARED validator the participant namespace is shared, so a bare
# hint like "Operator" collides with another team's "Operator". Empty (default) = sandbox.
# Set NELVA_PARTY_PREFIX=nelva- on a shared DevNet validator (5N).
# NELVA_PARTY_PREFIX=

# JWT auth (DevNet / LocalNet / NaaS). Leave AUTH_TOKEN_URL UNSET for dpm sandbox (no auth).
# OAuth2 client_credentials → Bearer on every Ledger API call. On an auth participant the
# BE also grants its token-user CanActAs on each party it allocates (else submit 403), and
# submits with the token's userId (its JWT `sub`), not LEDGER_USER_ID.
# AUTH_TOKEN_URL=https://<oidc-issuer>/realms/<realm>/protocol/openid-connect/token
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_SCOPE=daml_ledger_api
# AUTH_AUDIENCE=

# ── PROVEN working config: 5N DevNet sandbox (verified full lifecycle 2026-07-05) ──
# Fill AUTH_CLIENT_SECRET from your own 5N M2M credential — NEVER commit the secret.
# LEDGER_MODE=canton
# JSON_LEDGER_API=https://ledger-api.validator.devnet.sandbox.fivenorth.io
# NELVA_PACKAGE_ID=198e9be837647ec88bec2e2b7d636977bb2ed1e4e0b7e51d481073d626e98585
# NELVA_PARTY_PREFIX=nelva-
# AUTH_TOKEN_URL=https://auth.sandbox.fivenorth.io/application/o/token/
# AUTH_CLIENT_ID=validator-devnet-m2m
# AUTH_CLIENT_SECRET=<your-5N-m2m-secret>
# AUTH_SCOPE=daml_ledger_api
# AUTH_AUDIENCE=validator-devnet-m2m
