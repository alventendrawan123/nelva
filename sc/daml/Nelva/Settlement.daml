-- | Nelva.Settlement — on-ledger matching, atomic settlement, loan lifecycle
-- (repay + pro-rata liquidation), and the AUDITOR re-verification (differentiator).
--
-- RunMatch (operator) and Verify (auditor) both call the SAME pure
-- `runDeterministicMatch`, so the auditor reproduces the operator's result
-- byte-for-byte and flips a RED badge on a dishonest match — impossible with a
-- black-box (e.g. TEE) matcher that is never re-executed.
module Nelva.Settlement where

import DA.Time (addRelTime, days, hours)
import DA.Optional (fromSome)
import DA.List (unique, find)
import DA.Foldable (mapA_)
import Nelva.Asset
import Nelva.Lending
import Nelva.Match
import Nelva.Credit

-- On-ledger tick: like the pure Tick but carries the SealedBid ContractId so
-- Accept can draw the funds. `bidId` kept for deterministic comparison in audit.
data MatchedTick = MatchedTick
  with
    lender : Party
    bidId : Text
    bidCid : ContractId SealedBid
    amount : Numeric 10
    rate : Numeric 10
  deriving (Eq, Show)

-- Oracle price (Canton has no native feed). Mock/operator-signed for demo.
template PriceUpdate
  with
    oracle : Party
    operator : Party
    instrument : Text
    price : Numeric 10
    asOf : Time
  where
    signatory oracle
    observer operator
    ensure price > 0.0   -- a non-positive price is never a valid quote (blocks price=0 abuse)

-- Oracle-priced swap venue: no AMM curve, no owner-price drain.
-- No AMM curve, no pre-funded inventory: the swapper's UNLOCKED in-Holding moves to
-- the operator's pool account and the custodian MINTS the out-Holding at the oracle
-- price. amountOut = amountIn * priceIn / priceOut. minAmountOut is a slippage floor.
template SwapPool
  with
    operator : Party
    custodian : Party
  where
    signatory operator, custodian

    -- swapper hands in `inCid` (their UNLOCKED Holding of instrumentIn), names
    -- instrumentOut, passes the two latest PriceUpdate cids. Returns the minted
    -- out-Holding. nonconsuming: the pool persists across swaps.
    nonconsuming choice Swap : ContractId Holding
      with
        swapper : Party
        inCid : ContractId Holding
        instrumentOut : Text
        priceInCid : ContractId PriceUpdate
        priceOutCid : ContractId PriceUpdate
        minAmountOut : Numeric 10
      controller swapper, operator
      do
        inH  <- fetch inCid
        pIn  <- fetch priceInCid
        pOut <- fetch priceOutCid
        now  <- getTime
        assertMsg "swapper does not own the in-holding" (inH.owner == swapper)
        assertMsg "in-holding is locked" (inH.locker == None)
        assertMsg "priceIn instrument mismatch"  (pIn.instrument == inH.instrument)
        assertMsg "priceOut instrument mismatch" (pOut.instrument == instrumentOut)
        assertMsg "non-positive priceIn"  (pIn.price > 0.0)
        assertMsg "non-positive priceOut" (pOut.price > 0.0)
        -- reject stale prices so a swapper can't replay an old favorable quote forever
        assertMsg "priceIn stale"  (pIn.asOf  > addRelTime now (hours (-24)))
        assertMsg "priceOut stale" (pOut.asOf > addRelTime now (hours (-24)))
        let amountOut = inH.amount * pIn.price / pOut.price
        assertMsg "amountOut rounds to zero" (amountOut > 0.0)
        assertMsg "slippage: amountOut < minAmountOut" (amountOut >= minAmountOut)
        _ <- exercise inCid Transfer with newOwner = operator
        create Holding with
          custodian
          owner = swapper
          amount = amountOut
          instrument = instrumentOut
          locker = None

template MatchProposal
  with
    operator : Party
    borrower : Party
    auditor : Party
    lenders : [Party]
    proposalId : Text
    principal : Numeric 10
    blendedRate : Numeric 10
    tier : Tier
    matchedTicks : [MatchedTick]
    inputBidCids : [ContractId SealedBid]   -- FULL set incl losers (for audit)
    roundBorrows : [BorrowInput]            -- ALL borrows that competed in this round (for audit context)
    borrowCid : ContractId BorrowIntent
    collateralCid : ContractId Holding
    collateralAmount : Numeric 10
    requiredCollateral : Numeric 10
    oracle : Party                          -- trusted price oracle bound at match time (Liquidate/ClaimExcess check it)
    instrument : Text
    maturity : Time
  where
    signatory operator
    -- lenders are intentionally NOT observers of a PENDING proposal: otherwise every
    -- co-matched lender could read rival lenders' ticks/rates via projection before the
    -- borrower even accepts. They become observers of the resulting Loan on Accept (where
    -- co-funders legitimately share the loan's composition). The `lenders` field is still
    -- carried to populate Loan.lenders and the AuditBadge.
    observer borrower, auditor

    -- Borrower accepts: ONE atomic transaction draws every matched lender's funds
    -- to the borrower, escrows the collateral, and creates the Loan. No operator
    -- custody — lender funds move via the lock each lender set at bid time.
    choice Accept : ContractId Loan
      controller borrower
      do
        _ <- mapA
              (\t -> exercise t.bidCid DrawForMatch with
                       matchedRate = t.rate
                       matchedAmount = t.amount
                       borrower)
              matchedTicks
        escrow <- exercise collateralCid DrawLocked with newOwner = operator
        archive borrowCid   -- consume the matched intent so it can't be re-matched
        loan <- create Loan with
          borrower
          operator
          auditor
          lenders
          loanKey = proposalId
          ticks = matchedTicks
          principal
          blendedRate
          tier
          collateralCid = escrow
          collateralAmount
          requiredCollateral
          oracle
          instrument
          maturity
        -- one PRIVATE position receipt per matched lender (observed only by that lender)
        mapA_
          (\t -> create LoanPosition with
                   operator, lender = t.lender, borrower, loanKey = proposalId
                   amount = t.amount, rate = t.rate, instrument, maturity)
          matchedTicks
        pure loan

    -- Borrower walks away: 5% of collateral is slashed to the operator, 95% is
    -- returned (unlocked) to the borrower. Discourages using proposals as free
    -- rate discovery (an atomic reject penalty that is actually paid out).
    choice Reject : ()
      controller borrower
      do
        let slash = collateralAmount * 0.05
        if slash <= 0.0
          -- slash rounds to 0 at Numeric 10: return all collateral instead of aborting
          then do _ <- exercise collateralCid Unlock; pure ()
          else do
            (_slash, remOpt) <- exercise collateralCid DrawLockedAmount with
              newOwner = operator
              drawAmount = slash
            case remOpt of
              Some rem -> do _ <- exercise rem Unlock; pure ()
              None -> pure ()
        -- Consume the matched intent too. Without this the BorrowIntent survives with a
        -- collateralCid that Reject just archived; the matcher then re-includes it and
        -- RunMatch's `fetch bi.collateralCid` aborts the ENTIRE round (matching wedged
        -- platform-wide). Archiving here mirrors Accept, which also consumes borrowCid.
        archive borrowCid

-- A single lender's PRIVATE view of their slice of a loan. Observed only by that lender
-- (operator is signatory), so co-funders never learn each other's discriminatory rate —
-- the Loan itself no longer projects `ticks` to the lender set. `loanKey` links the
-- receipts to their loan so Repay/Liquidate can retire them.
template LoanPosition
  with
    operator : Party
    lender : Party
    borrower : Party
    loanKey : Text
    amount : Numeric 10
    rate : Numeric 10
    instrument : Text
    maturity : Time
  where
    signatory operator
    observer lender

template Loan
  with
    borrower : Party
    operator : Party
    auditor : Party
    lenders : [Party]
    loanKey : Text                          -- stable id linking the per-lender LoanPositions
    ticks : [MatchedTick]
    principal : Numeric 10
    blendedRate : Numeric 10
    tier : Tier
    collateralCid : ContractId Holding
    collateralAmount : Numeric 10
    requiredCollateral : Numeric 10
    oracle : Party                          -- trusted price oracle (Liquidate/ClaimExcess reject prices from any other signer)
    instrument : Text
    maturity : Time
  where
    signatory borrower, operator
    -- lenders are NOT observers: a co-funder must not read rival ticks/rates via the Loan.
    -- Each lender sees only their own LoanPosition; auditor keeps full visibility for audit.
    observer auditor
    ensure collateralAmount >= requiredCollateral   -- ledger-enforced over-collateralization

    -- Borrower repays: pays each lender principal + flat interest (at THEIR own
    -- rate, discriminatory) from `repaymentCid`, releases collateral, tier up.
    choice Repay : ()
      with
        repaymentCid : ContractId Holding
        creditScoreCid : ContractId CreditScore
        positionCids : [ContractId LoanPosition]
      controller borrower
      do
        cs <- fetch creditScoreCid
        assertMsg "credit score not for this borrower/operator" (cs.borrower == borrower && cs.operator == operator)
        _ <- payLenders (Some repaymentCid) ticks
        _ <- exercise collateralCid Transfer with newOwner = borrower
        _ <- exercise creditScoreCid BumpUp
        retirePositions loanKey positionCids
        pure ()

    -- Borrower reclaims collateral ABOVE requiredCollateral mid-loan. After Accept
    -- the escrow is owned by the OPERATOR and UNLOCKED (Accept ran DrawLocked which
    -- clears the locker), so DrawLockedAmount would abort (it asserts locker /= None).
    -- Use Split + Transfer (both controller=owner=operator, assert locker==None) —
    -- the same primitives payLenders/distribute already use on the escrow. This Loan
    -- is co-signed by the operator, so a borrower-controller body carries operator
    -- authority. Re-create the Loan with the remaining escrow (ensure still holds at
    -- equality).
    choice ClaimExcess : ContractId Loan
      with priceCid : ContractId PriceUpdate
      controller borrower
      do
        pu <- fetch priceCid
        now <- getTime
        assertMsg "wrong instrument" (pu.instrument == instrument)
        assertMsg "untrusted oracle" (pu.oracle == oracle)
        assertMsg "stale price" (pu.asOf > addRelTime now (hours (-24)))
        let excess = collateralAmount - requiredCollateral
        assertMsg "no excess collateral to claim" (excess > 0.0)
        -- Only allow the withdrawal if the position stays HEALTHY afterwards at the current
        -- price. Otherwise a borrower whose collateral has fallen in value could strip the
        -- nominal 'excess' just before Liquidate and leave lenders under-recovered.
        let healthAfter = (requiredCollateral * pu.price) / principal
        assertMsg "withdrawal would leave the loan under-collateralized at current price" (healthAfter >= 1.5)
        (excessPiece, remOpt) <- exercise collateralCid Split with splitAmount = excess
        _ <- exercise excessPiece Transfer with newOwner = borrower
        newEscrow <- case remOpt of
          Some r -> pure r
          None -> abort "escrow split produced no remainder"
        create this with
          collateralCid = newEscrow
          collateralAmount = requiredCollateral

    -- Operator liquidates an unhealthy/matured loan: 5% fee (kept by operator) +
    -- 95% pro-rata to lenders by matched amount, dust -> last lender; tier down.
    choice Liquidate : ()
      with
        priceCid : ContractId PriceUpdate
        creditScoreCid : ContractId CreditScore
        positionCids : [ContractId LoanPosition]
      controller operator
      do
        pu <- fetch priceCid
        now <- getTime
        cs <- fetch creditScoreCid
        assertMsg "wrong instrument" (pu.instrument == instrument)
        -- price must come from the oracle bound to THIS loan (blocks a puppet-oracle seizure)
        assertMsg "untrusted oracle" (pu.oracle == oracle)
        assertMsg "credit score not for this borrower/operator" (cs.borrower == borrower && cs.operator == operator)
        let matured = now > maturity
            fresh = pu.asOf > addRelTime now (hours (-24))
            health = (collateralAmount * pu.price) / principal
            -- genuine default: distressed AND provable with a fresh price
            unhealthy = health < 1.5 && fresh
        assertMsg "loan still healthy or price stale" (matured || unhealthy)
        if unhealthy
          then do
            -- default: 5% fee kept by operator, 95% pro-rata to lenders by principal; tier down.
            let distributable = collateralAmount - (collateralAmount * 0.05)
                shares = sharesWithDust distributable principal ticks
            distribute collateralCid shares
            _ <- exercise creditScoreCid BumpDown
            pure ()
          else do
            -- matured but HEALTHY (not a default): pay each lender exactly principal+interest
            -- owed and return the surplus over-collateral to the borrower. No punitive full
            -- seizure and no tier-down — the borrower was over-collateralized, just late.
            let owed = foldl (\a t -> a + t.amount + t.amount * t.rate) 0.0 ticks
                toLenders = min collateralAmount owed
                surplus = collateralAmount - toLenders
                shares = sharesByOwed toLenders ticks ++ [(borrower, surplus)]
            distribute collateralCid shares
            pure ()
        retirePositions loanKey positionCids

template MatchRound
  with
    operator : Party
    auditor : Party
  where
    signatory operator
    observer auditor

    -- Operator runs the deterministic match and publishes one MatchProposal per
    -- filled borrow (committing the FULL bid set incl losers).
    choice RunMatch : [ContractId MatchProposal]
      with
        bidCids : [ContractId SealedBid]
        borrowCids : [ContractId BorrowIntent]
        creditScoreCids : [ContractId CreditScore]   -- operator-signed scores, to validate each borrow's tier
        oracle : Party                               -- trusted price oracle, bound into each Loan for Liquidate/ClaimExcess
      controller operator
      do
        now <- getTime
        bids <- mapA (\cid -> do b <- fetch cid; pure (cid, b)) bidCids
        borrows <- mapA (\cid -> do b <- fetch cid; pure (cid, b)) borrowCids
        scores <- mapA fetch creditScoreCids
        -- app-assigned ids must be unique in a round: a duplicate bidId collapses capacity
        -- in the matcher's Map.fromList (last-wins) and misroutes ticks.
        assertMsg "duplicate bidId in round" (unique (map (\(_, b) -> b.bidId) bids))
        assertMsg "duplicate borrowId in round" (unique (map (\(_, b) -> b.borrowId) borrows))
        -- TIER BINDING: only match a borrow whose self-declared tier equals its
        -- operator-signed CreditScore tier. A borrower who lies (e.g. picks Platinum for
        -- 1.2x collateral) has no matching score and is silently excluded — no under-
        -- collateralized loan can form. Honest borrows (BE keeps tier == score) pass.
        let tierOk bi = case find (\s -> s.borrower == bi.borrower && s.operator == operator && s.tier == bi.tier) scores of
                          Some _ -> True
                          None -> False
            validBorrows = filter (\(_, bi) -> tierOk bi) borrows
        let bidInputs = map (\(_, b) -> bidToInput b) bids
            borrowInputs = map (\(_, b) -> borrowToInput b) validBorrows
            result = runDeterministicMatch bidInputs borrowInputs
            cidByBidId = map (\(cid, b) -> (b.bidId, cid)) bids
            borrowByBorrowId = map (\(cid, b) -> (b.borrowId, (cid, b))) validBorrows
        mapA
          (\f -> do
            let mtks = map
                        (\t -> MatchedTick t.lender t.bidId (fromSome (lookup t.bidId cidByBidId)) t.amount t.rate)
                        f.ticks
                (bcid, bi) = fromSome (lookup f.borrowId borrowByBorrowId)
                reqColl = f.principal * multiplier bi.tier
            coll <- fetch bi.collateralCid
            create MatchProposal with
              operator
              borrower = f.borrower
              auditor = bi.auditor
              lenders = map (\t -> t.lender) f.ticks
              proposalId = "P-" <> f.borrowId
              principal = f.principal
              blendedRate = f.blendedRate
              tier = bi.tier
              matchedTicks = mtks
              inputBidCids = bidCids
              roundBorrows = borrowInputs
              borrowCid = bcid
              collateralCid = bi.collateralCid
              collateralAmount = coll.amount
              requiredCollateral = reqColl
              oracle
              instrument = bi.instrument
              maturity = addRelTime now (days 30))
          result.fills

-- Auditor re-verification (the differentiator).
template VerifyRequest
  with
    auditor : Party
  where
    signatory auditor

    -- Re-runs the IDENTICAL deterministic match over the proposal's committed
    -- bids + borrow and compares to the published ticks/blended rate.
    -- Match -> GREEN ; any divergence -> RED.
    nonconsuming choice Verify : ContractId AuditBadge
      with proposalCid : ContractId MatchProposal
      controller auditor
      do
        p <- fetch proposalCid
        bids <- mapA (\cid -> fetch cid) p.inputBidCids
        bi <- fetch p.borrowCid
        -- Re-run the matcher over the SAME joint context RunMatch used (all borrows that
        -- competed for the shared bid capacity), then select the fill for THIS borrow.
        -- Recomputing a single borrow in isolation over full capacity would diverge from
        -- the real multi-borrow round -> false RED on honest matches / false GREEN on cheats.
        let bidInputs = map bidToInput bids
            recomputed = runDeterministicMatch bidInputs p.roundBorrows
            thisFill = find (\f -> f.borrowId == bi.borrowId) recomputed.fills
            expectedTicks = case thisFill of
                              Some f -> f.ticks
                              None -> []
            expectedBlended = case thisFill of
                                Some f -> f.blendedRate
                                None -> 0.0
            publishedTicks = map (\mt -> Tick mt.lender mt.bidId mt.amount mt.rate) p.matchedTicks
            ok = expectedTicks == publishedTicks && expectedBlended == p.blendedRate
        create AuditBadge with
          auditor
          operator = p.operator
          borrower = p.borrower
          lenders = p.lenders
          proposalId = p.proposalId
          verdict = ok

template AuditBadge
  with
    auditor : Party
    operator : Party
    borrower : Party
    lenders : [Party]
    proposalId : Text
    verdict : Bool   -- True = GREEN (honest match), False = RED (dishonest)
  where
    signatory auditor
    -- lenders are NOT observers: the badge lists the full lender set, which would disclose
    -- co-funders to each other. Operator + borrower suffice for the audit trail.
    observer operator, borrower

-- ── helpers ────────────────────────────────────────────────────────────────

-- Pay each lender principal + flat interest (rate * amount) from the borrower's
-- repayment holding, splitting it piece by piece. Aborts if underfunded.
payLenders : Optional (ContractId Holding) -> [MatchedTick] -> Update (Optional (ContractId Holding))
payLenders remOpt [] = pure remOpt
payLenders None (_ :: _) = abort "insufficient repayment funds"
payLenders (Some remCid) (t :: ts) = do
  let owed = t.amount + (t.amount * t.rate)
  (piece, rest) <- exercise remCid Split with splitAmount = owed
  _ <- exercise piece Transfer with newOwner = t.lender
  payLenders rest ts

-- Pro-rata shares of `distributable` by tick amount / totalPrincipal, with any
-- rounding dust assigned to the LAST lender so sum-of-parts == distributable.
sharesWithDust : Numeric 10 -> Numeric 10 -> [MatchedTick] -> [(Party, Numeric 10)]
sharesWithDust distributable totalPrincipal ticks =
  let raw = map (\t -> (t.lender, distributable * t.amount / totalPrincipal)) ticks
      summed = foldl (\acc (_, s) -> acc + s) 0.0 raw
      dust = distributable - summed
  in case reverse raw of
       ((p, s) :: rest) -> reverse ((p, s + dust) :: rest)
       [] -> []

-- Pro-rata shares of `total` by each tick's OWED amount (principal + interest), with any
-- rounding dust assigned to the LAST recipient. Used on the matured-healthy Liquidate path.
sharesByOwed : Numeric 10 -> [MatchedTick] -> [(Party, Numeric 10)]
sharesByOwed total ticks =
  let owedOf t = t.amount + t.amount * t.rate
      totalOwed = foldl (\acc t -> acc + owedOf t) 0.0 ticks
      raw = map (\t -> (t.lender, if totalOwed > 0.0 then total * owedOf t / totalOwed else 0.0)) ticks
      summed = foldl (\acc (_, s) -> acc + s) 0.0 raw
      dust = total - summed
  in case reverse raw of
       ((p, s) :: rest) -> reverse ((p, s + dust) :: rest)
       [] -> []

-- Split the seized collateral, transferring each lender's share; leftover (fee)
-- stays owned by the holder (operator).
distribute : ContractId Holding -> [(Party, Numeric 10)] -> Update ()
distribute _ [] = pure ()
distribute remCid ((lender, share) :: rest) =
  -- skip zero/negative shares (Split asserts > 0.0, which would otherwise abort the whole
  -- Liquidate when a tiny pro-rata share rounds to 0.0 at Numeric 10).
  if share <= 0.0
    then distribute remCid rest
    else do
      (piece, remOpt) <- exercise remCid Split with splitAmount = share
      _ <- exercise piece Transfer with newOwner = lender
      case remOpt of
        Some r -> distribute r rest
        None -> pure ()

-- Retire a loan's per-lender position receipts (assert each belongs to this loan).
retirePositions : Text -> [ContractId LoanPosition] -> Update ()
retirePositions key cids =
  mapA_ (\c -> do
          lp <- fetch c
          assertMsg "position not for this loan" (lp.loanKey == key)
          archive c)
        cids
