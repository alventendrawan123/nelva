-- | Flow tests for the asset + bid layer: proves the LOCK-as-preauthorization
-- mechanism — the operator draws a lender's locked funds to the borrower on
-- match, with NO operator custody, all from the lender's prior consent.
--
-- Run: dpm test --files daml/Nelva/Test/FlowTest.daml
module Nelva.Test.FlowTest where

import Daml.Script
import DA.Assert ((===))
import DA.Time (addRelTime, days)
import Nelva.Asset
import Nelva.Lending

-- mint -> lock -> bid -> operator draws to borrower (rate within cap).
testLockBidDraw : Script ()
testLockBidDraw = do
  custodian <- allocateParty "Custodian"
  lender <- allocateParty "Lender"
  operator <- allocateParty "Operator"
  borrower <- allocateParty "Borrower"
  auditor <- allocateParty "Auditor"
  now <- getTime

  cash <- submit custodian do
    createCmd Holding with custodian, owner = lender, amount = 100.0, instrument = "USD", locker = None
  lockedCash <- submit lender do exerciseCmd cash Lock with newLocker = operator
  bid <- submit lender do
    createCmd SealedBid with
      lender, matchingOperator = operator, auditor, bidId = "bidA", holdingCid = lockedCash
      amount = 100.0, bidRate = 0.05, instrument = "USD", deadline = addRelTime now (days 1)

  -- operator matches at 0.04 (<= 0.05), full amount, and moves the funds to the borrower.
  -- DrawForMatch now requires borrower co-authority (operator alone can no longer drain).
  drawn <- submitMulti [operator, borrower] [] do
    exerciseCmd bid DrawForMatch with matchedRate = 0.04, matchedAmount = 100.0, borrower

  Some bh <- queryContractId borrower drawn
  bh.owner === borrower
  bh.amount === 100.0
  bh.locker === None

-- a matched rate ABOVE the lender's cap must be rejected.
testDrawAboveCapFails : Script ()
testDrawAboveCapFails = do
  custodian <- allocateParty "Custodian2"
  lender <- allocateParty "Lender2"
  operator <- allocateParty "Operator2"
  borrower <- allocateParty "Borrower2"
  auditor <- allocateParty "Auditor2"
  now <- getTime

  cash <- submit custodian do
    createCmd Holding with custodian, owner = lender, amount = 50.0, instrument = "USD", locker = None
  lockedCash <- submit lender do exerciseCmd cash Lock with newLocker = operator
  bid <- submit lender do
    createCmd SealedBid with
      lender, matchingOperator = operator, auditor, bidId = "bidX", holdingCid = lockedCash
      amount = 50.0, bidRate = 0.03, instrument = "USD", deadline = addRelTime now (days 1)

  -- fails on the rate-cap assert (both authorities present, so it's not an auth failure)
  submitMultiMustFail [operator, borrower] [] do
    exerciseCmd bid DrawForMatch with matchedRate = 0.05, matchedAmount = 50.0, borrower

-- C1 regression: the operator ALONE can no longer drain a lender's locked bid.
testOperatorCannotDrainAlone : Script ()
testOperatorCannotDrainAlone = do
  custodian <- allocateParty "Custodian3"
  lender <- allocateParty "Lender3"
  operator <- allocateParty "Operator3"
  auditor <- allocateParty "Auditor3"
  now <- getTime
  cash <- submit custodian do
    createCmd Holding with custodian, owner = lender, amount = 100.0, instrument = "USD", locker = None
  lockedCash <- submit lender do exerciseCmd cash Lock with newLocker = operator
  bid <- submit lender do
    createCmd SealedBid with
      lender, matchingOperator = operator, auditor, bidId = "bidZ", holdingCid = lockedCash
      amount = 100.0, bidRate = 0.05, instrument = "USD", deadline = addRelTime now (days 1)
  -- operator alone, trying to redirect the funds to itself, must FAIL (needs borrower auth)
  submitMustFail operator do
    exerciseCmd bid DrawForMatch with matchedRate = 0.0, matchedAmount = 100.0, borrower = operator
